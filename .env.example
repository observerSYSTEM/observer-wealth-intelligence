# Copy this file to .env for local use. Never commit .env.
# Required secret-bearing values are intentionally blank.
# deploy/install.sh and deploy/install-pi.sh generate local values when .env is created.

APP_NAME=Observer Wealth Intelligence
APP_VERSION=1.0.0-rc.1
ENVIRONMENT=development
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RECEIPT_MAX_FILE_SIZE_BYTES=10485760
RECEIPT_STORAGE_PATH=data/receipts
ASSET_STORAGE_PATH=data/assets
VAULT_STORAGE_PATH=data/vault
OCR_STORAGE_PATH=data/ocr
BACKUP_STORAGE_PATH=data/backups
VAULT_MAX_FILE_SIZE_BYTES=26214400
EASYOCR_LANGUAGES=["en"]
OCR_LOW_CONFIDENCE_THRESHOLD=70
OCR_PDF_PAGE_LIMIT=3
OCR_PDF_RENDER_DPI=150
OCR_IMAGE_MAX_PIXELS=20000000
OCR_MAX_RETRIES=3
OCR_WORKER_POLL_SECONDS=5
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_TIME=02:30

POSTGRES_DB=observer_wealth
POSTGRES_USER=observer
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKUP_DIR=./data/backups
BACKUP_RETENTION_COUNT=7
INCLUDE_SECRETS_IN_BACKUP=false
