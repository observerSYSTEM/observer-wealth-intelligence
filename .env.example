APP_NAME=Observer Wealth Intelligence
ENVIRONMENT=development
SECRET_KEY=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

POSTGRES_DB=observer_wealth
POSTGRES_USER=observer
POSTGRES_PASSWORD=observer-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://observer:observer-local-password@db:5432/observer_wealth

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKUP_DIR=./backups
